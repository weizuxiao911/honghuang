{
  "name": "taichu-chat-window",
  "displayName": "Taichu 对话窗口",
  "description": "Taichu 右侧对话窗口：按会话隔离，直连 opencode SDK，SSE 实时更新",
  "version": "0.1.0",
  "publisher": "taichu",
  "engines": {
    "vscode": "^1.57.0"
  },
  "categories": ["Chat"],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "browser": "./out/views.js",
  "contributes": {
    "commands": [
      {
        "command": "taichu.chat.refresh",
        "title": "刷新对话",
        "category": "Taichu"
      }
    ]
  },
  "sumiContributes": {
    "workerMain": "./out/extension.js",
    "browserMain": "./out/views.js",
    "browserViews": {
      "right": {
        "type": "add",
        "view": [
          {
            "id": "chatWindow",
            "icon": "message",
            "title": "Taichu 对话"
          }
        ]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies --allow-missing-repository --allow-star-activation"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.8"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.4"
  }
}
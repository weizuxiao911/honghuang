### opencode serve — 全部 API（188 个端点，自动生成自运行实例 /doc）
### 用法：VS Code REST Client 逐条 Send Request。
### 说明：
###   - 路径参数（sid/msgId 等）已抽成变量，运行前用真实值填写下方 @ 定义
###   - provider/model 留空即用服务端默认；也可填 volcengine-agent-plan / ark-code-latest
###   - 请求体为 schema 字段骨架，值需按需填写（"" 为占位）

@base = http://127.0.0.1:24096
@provider =
@model =
@agent = build
@attemptId =
@credId =
@id =
@integrationId =
@msgId =
@partId =
@permId =
@projId =
@ptyId =
@reqId =
@sid =


############################################################
## 常用示例（可直接运行，含完整请求体）
############################################################

### 创建会话（返回 id，填入上方 @sid）
# @name 创建会话
POST {{base}}/session
Accept: application/json
Content-Type: application/json

{
  "title": "demo"
}


### 发送消息 — 同步等待（parts 必填；provider/model 可留空用默认）
POST {{base}}/session/{{sid}}/message
Accept: application/json
Content-Type: application/json

{
  "agent": "{{agent}}",
  "parts": [
    { "type": "text", "text": "在 /workspace 下创建 hello.txt，内容为 HELLO" }
  ]
}


### 发送消息 — 异步（立即返回 204，结果走 SSE / 消息历史）
POST {{base}}/session/{{sid}}/prompt_async
Accept: application/json
Content-Type: application/json

{
  "agent": "{{agent}}",
  "parts": [
    { "type": "text", "text": "逐步创建一个 Node 项目骨架" }
  ]
}


### 在会话中运行 shell
POST {{base}}/session/{{sid}}/shell
Accept: application/json
Content-Type: application/json

{
  "agent": "{{agent}}",
  "command": "ls -la /workspace"
}


### 创建 PTY 终端并执行命令
POST {{base}}/pty
Accept: application/json
Content-Type: application/json

{
  "command": "/bin/bash",
  "args": ["-c", "echo WRITTEN_BY_PTY > /workspace/pty.txt"],
  "cwd": "/workspace"
}



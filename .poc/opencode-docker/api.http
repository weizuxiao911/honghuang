Accept: application/json


############################################################
## /api/*（v2 镜像路由，与主路由等价）
############################################################

### 131. 列出所有 agent
GET {{base}}/api/agent
Accept: application/json


### 132. 列出命令
GET {{base}}/api/command
Accept: application/json


### 133. 移除凭证
DELETE {{base}}/api/credential/{{credId}}
Accept: application/json


### 134. 更新凭证
PATCH {{base}}/api/credential/{{credId}}
Accept: application/json
Content-Type: application/json

{
  "label": ""
}


### 135. 订阅全局事件流(SSE)
GET {{base}}/api/event
Accept: application/json


### 136. 按名查找文件
GET {{base}}/api/fs/find
Accept: application/json


### 137. 列出目录
GET {{base}}/api/fs/list
Accept: application/json


### 138. 读取文件内容
GET {{base}}/api/fs/read/*
Accept: application/json


### 139. 检查服务健康
GET {{base}}/api/health
Accept: application/json


### 140. 列出集成
GET {{base}}/api/integration
Accept: application/json


### 141. 获取集成
GET {{base}}/api/integration/{{integrationId}}
Accept: application/json


### 142. 用密钥连接集成
POST {{base}}/api/integration/{{integrationId}}/connect/key
Accept: application/json
Content-Type: application/json

{
  "key": ""
}


### 143. 发起 OAuth 连接
POST {{base}}/api/integration/{{integrationId}}/connect/oauth
Accept: application/json
Content-Type: application/json

{
  "methodID": "",
  "inputs": {}
}


### 144. 取消 OAuth 连接
DELETE {{base}}/api/integration/attempt/{{attemptId}}
Accept: application/json


### 145. 获取 OAuth 尝试状态
GET {{base}}/api/integration/attempt/{{attemptId}}
Accept: application/json


### 146. 完成 OAuth 连接
POST {{base}}/api/integration/attempt/{{attemptId}}/complete
Accept: application/json
Content-Type: application/json

{
  "code": ""
}



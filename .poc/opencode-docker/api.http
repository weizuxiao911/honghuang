Accept: application/json


### 6. 更新配置
PATCH {{base}}/config
Accept: application/json
Content-Type: application/json

{
  "$schema": "",
  "shell": "",
  "logLevel": "",
  "server": {
    "port": "",
    "hostname": "",
    "mdns": "",
    "mdnsDomain": "",
    "cors": ""
  },
  "command": {},
  "skills": {
    "paths": [],
    "urls": []
  },
  "references": {},
  "reference": {},
  "watcher": {
    "ignore": []
  },
  "snapshot": false,
  "plugin": [],
  "share": "",
  "autoshare": false,
  "autoupdate": false,
  "disabled_providers": [
    ""
  ],
  "enabled_providers": [
    ""
  ],
  "model": "",
  "small_model": "",
  "default_agent": "",
  "subagent_depth": 0,
  "username": "",
  "mode": {
    "build": "",
    "plan": ""
  },
  "agent": {
    "plan": "",
    "build": "",
    "general": "",
    "explore": "",
    "title": "",
    "summary": "",
    "compaction": ""
  },
  "provider": {},
  "mcp": {},
  "formatter": false,
  "lsp": false,
  "instructions": [
    ""
  ],
  "layout": "",
  "permission": "",
  "tools": {},
  "attachment": {
    "image": ""
  },
  "enterprise": {
    "url": ""
  },
  "tool_output": {
    "max_lines": 0,
    "max_bytes": 0
  },
  "compaction": {
    "auto": false,
    "prune": false,
    "tail_turns": 0,
    "preserve_recent_tokens": 0,
    "reserved": 0
  },
  "experimental": {
    "disable_paste_summary": false,
    "batch_tool": false,
    "openTelemetry": false,
    "primary_tools": [],
    "continue_loop_on_deny": false,
    "mcp_timeout": 0,
    "policies": []
  }
}



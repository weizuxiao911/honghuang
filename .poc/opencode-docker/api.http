Accept: application/json


### 154. 列出 PTY 会话
GET {{base}}/api/pty
Accept: application/json


### 155. 创建 PTY 终端会话
POST {{base}}/api/pty
Accept: application/json
Content-Type: application/json

{
  "command": "",
  "args": [
    ""
  ],
  "cwd": "",
  "title": "",
  "env": {}
}


### 156. 移除 PTY 会话
DELETE {{base}}/api/pty/{{ptyId}}
Accept: application/json


### 157. 获取 PTY 会话
GET {{base}}/api/pty/{{ptyId}}
Accept: application/json


### 158. 更新 PTY 会话
PUT {{base}}/api/pty/{{ptyId}}
Accept: application/json
Content-Type: application/json

{
  "title": "",
  "size": {
    "rows": 0,
    "cols": 0
  }
}


### 159. 连接 PTY 会话(WebSocket)
GET {{base}}/api/pty/{{ptyId}}/connect
Accept: application/json


### 160. 创建 PTY WebSocket 令牌
POST {{base}}/api/pty/{{ptyId}}/connect-token
Accept: application/json


### 161. 列出待处理提问请求
GET {{base}}/api/question/request
Accept: application/json


### 162. 列出引用
GET {{base}}/api/reference
Accept: application/json


### 163. 列出会话
GET {{base}}/api/session
Accept: application/json


### 164. 创建会话
POST {{base}}/api/session
Accept: application/json
Content-Type: application/json

{
  "id": "",
  "agent": "",
  "model": {
    "id": "",
    "providerID": ""
  },
  "location": {
    "directory": ""
  }
}


### 165. 获取会话详情
GET {{base}}/api/session/{{sid}}
Accept: application/json


### 166. 切换会话 agent
POST {{base}}/api/session/{{sid}}/agent
Accept: application/json
Content-Type: application/json

{
  "agent": ""
}


### 167. 压缩会话上下文
POST {{base}}/api/session/{{sid}}/compact
Accept: application/json


### 168. 获取会话上下文
GET {{base}}/api/session/{{sid}}/context
Accept: application/json


### 169. 订阅会话事件流(SSE)
GET {{base}}/api/session/{{sid}}/event
Accept: application/json


### 170. 获取会话历史
GET {{base}}/api/session/{{sid}}/history
Accept: application/json


### 171. 打断会话执行
POST {{base}}/api/session/{{sid}}/interrupt
Accept: application/json


### 172. 获取会话消息列表
GET {{base}}/api/session/{{sid}}/message
Accept: application/json


### 173. 获取会话消息
GET {{base}}/api/session/{{sid}}/message/{{msgId}}
Accept: application/json


### 174. 切换会话模型
POST {{base}}/api/session/{{sid}}/model
Accept: application/json
Content-Type: application/json

{
  "model": {
    "id": "",
    "providerID": ""
  }
}


### 175. 列出会话权限请求
GET {{base}}/api/session/{{sid}}/permission
Accept: application/json


### 176. 创建权限请求
POST {{base}}/api/session/{{sid}}/permission
Accept: application/json
Content-Type: application/json

{
  "action": "",
  "resources": [
    ""
  ]
}


### 177. 获取权限请求
GET {{base}}/api/session/{{sid}}/permission/{{reqId}}
Accept: application/json


### 178. 回复待处理权限请求
POST {{base}}/api/session/{{sid}}/permission/{{reqId}}/reply
Accept: application/json
Content-Type: application/json

{
  "reply": ""
}


### 179. 发送消息(同步等待响应)
POST {{base}}/api/session/{{sid}}/prompt
Accept: application/json
Content-Type: application/json

{
  "prompt": {
    "text": ""
  }
}


### 180. 列出会话提问请求
GET {{base}}/api/session/{{sid}}/question
Accept: application/json


### 181. 拒绝待处理提问
POST {{base}}/api/session/{{sid}}/question/{{reqId}}/reject
Accept: application/json


### 182. 回复待处理提问
POST {{base}}/api/session/{{sid}}/question/{{reqId}}/reply
Accept: application/json
Content-Type: application/json

{
  "answers": []
}


### 183. 清除暂存的回退
POST {{base}}/api/session/{{sid}}/revert/clear
Accept: application/json


### 184. 提交暂存的回退
POST {{base}}/api/session/{{sid}}/revert/commit
Accept: application/json


### 185. 暂存会话回退
POST {{base}}/api/session/{{sid}}/revert/stage
Accept: application/json
Content-Type: application/json

{
  "messageID": ""
}


### 186. 等待会话完成
POST {{base}}/api/session/{{sid}}/wait
Accept: application/json


### 187. 列出活跃会话
GET {{base}}/api/session/active
Accept: application/json


### 188. 列出所有 skill
GET {{base}}/api/skill
Accept: application/json


# Taichu Client 环境配置模板
# 复制为 .env.development / .env.staging / .env.production 后修改具体值
# 命名约定: DEPLOY_ENV 决定当前激活的 .env 文件 (dotenv-webpack / dotenv 行为)

# 当前环境标识 (development | staging | production)
DEPLOY_ENV=development

# 各服务 HOST (按环境划分, K8s ConfigMap 也按 .env.* 同步维护)
# dev:     *.taichu.localhost
# staging: *.staging.taichu.com
# prod:    *.taichu.com
GATEWAY_URL=http://gateway.taichu.localhost
REGISTRY_URL=http://registry.taichu.localhost
RUNTIME_HOST_SUFFIX=runtime.taichu.localhost

# OpenCode SDK base URL (dev 调试用, 沙箱内为 {runtimeId}.{RUNTIME_HOST_SUFFIX})
OPENCODE_BASE_URL=http://127.0.0.1:24096

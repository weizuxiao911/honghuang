# 依赖
node_modules/

# 过程产物统一放 .cache/（不入库）
.cache/

# Playwright MCP 本地工具产物（截图 / 快照 / 控制台日志等）
.playwright-mcp/

# 调研产物（.poc/）整目录忽略
.poc/

# 正式工程（app / registry / gateway / agent-image）的预期产物占位
app/dist/
app/out/
app/*.vsix
app/extensions/*/out/
app/extensions/*/*.vsix
registry/dist/
registry/build/
registry/*.jar
gateway/target/
gateway/build/
gateway/*.jar
gateway/k8s/local/
agent-image/build/
agent-image/dist/
agent-image/workspace/
agent-image/data/
agent-image/config/

# 编辑器/系统
.DS_Store
.idea/
.vscode/
*.log
*.iml
*.classpath
*.project
.settings/
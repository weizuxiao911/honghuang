{
  "name": "taichu-session-manager",
  "displayName": "Taichu 会话管理",
  "description": "Taichu 左侧会话管理面板：列出 / 新建 / 切换 opencode 会话",
  "version": "0.1.0",
  "publisher": "taichu",
  "engines": {
    "vscode": "^1.60.0",
    "kaitian": "*",
    "opensumi": "*"
  },
  "activationEvents": [
    "*"
  ],
  "browser": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taichu.session.refresh",
        "title": "刷新会话列表",
        "category": "Taichu"
      },
      {
        "command": "taichu.session.create",
        "title": "新建会话",
        "category": "Taichu"
      }
    ]
  },
  "sumiContributes": {
    "workerMain": "./out/extension.js",
    "browserMain": "./out/views.js",
    "browserViews": {
      "left": {
        "type": "add",
        "view": [
          {
            "id": "sessionManager",
            "icon": "add-comments",
            "title": "Taichu 会话"
          }
        ]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.4"
  }
}
{
  "name": "taichu-landing-page",
  "displayName": "Taichu 着陆页",
  "description": "Taichu 默认着陆页: Trae 风格空态(5 颗动作按钮 + 最近项目列表)。所有 IO 派发全局 command,由 app 或其他 VSIX 接走;本扩展不直接读写文件、不直连 Agent API。",
  "version": "0.1.0",
  "publisher": "taichu",
  "engines": {
    "vscode": "^1.57.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "browser": "./out/views.js",
  "contributes": {
    "commands": [
      {
        "command": "taichu.landing.openFolder",
        "title": "打开文件夹",
        "category": "Taichu"
      },
      {
        "command": "taichu.landing.newProject",
        "title": "新建项目",
        "category": "Taichu"
      },
      {
        "command": "taichu.landing.cloneGit",
        "title": "克隆 Git 仓库",
        "category": "Taichu"
      },
      {
        "command": "taichu.landing.remoteHost",
        "title": "连接远程主机",
        "category": "Taichu"
      },
      {
        "command": "taichu.landing.newFile",
        "title": "新建文件",
        "category": "Taichu"
      }
    ]
  },
  "sumiContributes": {
    "workerMain": "./out/extension.js",
    "browserMain": "./out/views.js",
    "browserViews": {
      "main": {
        "type": "add",
        "view": [
          {
            "id": "taichuLanding",
            "icon": "home",
            "title": "Taichu 着陆"
          }
        ]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies --allow-missing-repository --allow-star-activation"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.4"
  }
}
